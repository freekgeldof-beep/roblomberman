<Item class="ServerScriptService" referent="RBX17"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX15"><Properties>
<string name="Name">BombermanServer</string>
<ProtectedString name="Source"><![CDATA[-- Roblomberman: server entry point (rounds and players).
-- The game rules live in the modules in the "Bomberman" folder:
--   Grid      grid helpers (cell <-> position, arena size)
--   State     shared game state
--   Net       RemoteEvents and round info for the clients
--   Sounds    sound effects
--   Powerups  goodies and curses
--   Arena     building the arena, crates, warps, belts, switch walls, sudden death
--   Bombs     placing / throwing / kicking / exploding bombs and fire
--   Bots      computer opponents
-- Player-facing text is never built here: we send message keys (see
-- ReplicatedStorage.Lang) and each client translates them.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage:WaitForChild("BombConfig"))
local Modules = script.Parent:WaitForChild("Bomberman")
local Grid = require(Modules:WaitForChild("Grid"))
local S = require(Modules:WaitForChild("State"))
local Net = require(Modules:WaitForChild("Net"))
local Sounds = require(Modules:WaitForChild("Sounds"))
local Powerups = require(Modules:WaitForChild("Powerups"))
local Arena = require(Modules:WaitForChild("Arena"))
local Bombs = require(Modules:WaitForChild("Bombs"))
local Bots = require(Modules:WaitForChild("Bots"))

Players.CharacterAutoLoads = false

Net.PlaceBomb.OnServerEvent:Connect(function(player)
	Bombs.place(player)
end)
Net.ThrowBomb.OnServerEvent:Connect(function(player)
	Bombs.throw(player)
end)

local roundNumber = 0
local matchOver = false -- true after someone won the match: the next round starts a new one

local function msg(k, a)
	return { k = k, a = a }
end

----------------------------------------------------------------------
-- Rounds
----------------------------------------------------------------------
local function updateAliveCount()
	local n = 0
	for _ in pairs(S.alive) do
		n += 1
	end
	Net.set("AliveCount", n)
end

local function setAlive(plr, value)
	S.alive[plr] = value and true or nil
	plr:SetAttribute("Alive", value and true or false)
	updateAliveCount()
end

local function getWins(plr)
	local ls = plr:FindFirstChild("leaderstats")
	return ls and ls:FindFirstChild("Wins")
end

-- Scoreboard for everyone: real players plus the bots that have played
local function sendResult(winner, title)
	local everyone = Players:GetPlayers()
	for _, bot in ipairs(Bots.all()) do
		everyone[#everyone + 1] = bot
	end
	local rows = {}
	for _, plr in ipairs(everyone) do
		local w = getWins(plr)
		local shown = Config.MATCH_WINS > 0 and (plr:GetAttribute("MatchWins") or 0) or (w and w.Value or 0)
		rows[#rows + 1] = {
			name = S.nameOf(plr),
			wins = shown,
			color = plr:GetAttribute("Color"),
			winner = plr == winner,
		}
	end
	table.sort(rows, function(a, b)
		if a.wins ~= b.wins then
			return a.wins > b.wins
		end
		return a.name < b.name
	end)
	local header = Config.MATCH_WINS > 0 and msg("wins_to", { n = Config.MATCH_WINS }) or msg("wins")
	Net.RoundResult:FireAllClients(title, rows, Config.INTERMISSION, header)
end

local function endRound(winner, reason)
	if S.roundState ~= "playing" then
		return
	end
	S.roundState = "over"
	Net.set("State", "over")
	Net.set("SuddenDeath", false)
	local title
	if winner then
		local w = getWins(winner)
		if w then
			w.Value += 1
		end
		title = msg("win_round", { name = S.nameOf(winner), n = roundNumber })
		Sounds.play("Win")
		if Config.MATCH_WINS > 0 then
			local mw = (winner:GetAttribute("MatchWins") or 0) + 1
			winner:SetAttribute("MatchWins", mw)
			if mw >= Config.MATCH_WINS then
				title = msg("match_win", { name = S.nameOf(winner) })
				matchOver = true
			end
		end
	else
		title = reason or msg("draw")
	end
	sendResult(winner, title)
end

local function checkRound()
	if S.roundState ~= "playing" then
		return
	end
	local count, last = 0, nil
	local humansInRound, humansAlive = 0, 0
	for plr in pairs(S.alive) do
		count += 1
		last = plr
		if not S.isBot(plr) then
			humansAlive += 1
		end
	end
	for _, plr in ipairs(S.roundPlayers) do
		if not S.isBot(plr) then
			humansInRound += 1
		end
	end

	if #S.roundPlayers >= 2 then
		if count <= 1 then
			endRound(last)
		elseif humansInRound > 0 and humansAlive == 0 then
			-- all real players are out: don't make them watch the bots for ages
			endRound(nil, msg("bots_win"))
		end
	elseif count == 0 then
		endRound(nil, msg("solo_out"))
	elseif #Players:GetPlayers() >= 2 then
		-- someone was practising alone and a second player joined:
		-- stop the practice round so everyone can start together
		endRound(nil, msg("new_player"))
	end
end

local function onDeath(player)
	if not S.alive[player] then
		return
	end
	setAlive(player, false)
	local root = S.getRoot(player)
	Sounds.play("Death", root and root.Position)
	local s = S.stats[player]
	if s and s.held then
		Bombs.explode(s.held)
	end
	Net.announce(msg("you_out"), 3, false, player)
	checkRound()
end

local function killOnCell(x, z)
	local plr = S.playerOnCell(Grid.cellOf, x, z)
	while plr do
		local hum = S.getHum(plr)
		if hum then
			hum.Health = 0
		end
		onDeath(plr) -- right away, so playerOnCell won't find them again
		plr = S.playerOnCell(Grid.cellOf, x, z)
	end
end

-- After the round time the arena closes in from the outside
local function suddenDeath()
	local myGen = S.gen
	Net.set("SuddenDeath", true)
	Net.announce(msg("sudden_death"), 3)
	for _, c in ipairs(Grid.spiral()) do
		if S.roundState ~= "playing" or S.gen ~= myGen then
			return
		end
		local x, z = c[1], c[2]
		if Arena.closeCell(x, z) then
			local b = S.bombAt[Grid.key(x, z)]
			if b then
				Bombs.explode(b)
			end
			task.wait(0.2) -- the block is still falling
			if S.roundState ~= "playing" or S.gen ~= myGen then
				return
			end
			killOnCell(x, z)
			task.wait(math.max(0, Config.SUDDEN_DEATH_STEP - 0.2))
		end
	end
end

local function colorCharacter(char, color)
	local hl = Instance.new("Highlight")
	hl.FillColor = color
	hl.FillTransparency = 0.45
	hl.OutlineColor = Color3.new(1, 1, 1)
	hl.OutlineTransparency = 0.2
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = char
end

local function startRound()
	-- who plays: real players first, then bots to fill up to BOT_FILL
	local humans = Players:GetPlayers()
	local participants = {}
	for i = 1, math.min(#humans, Config.MAX_PLAYERS) do
		participants[i] = humans[i]
	end
	for i = Config.MAX_PLAYERS + 1, #humans do
		Net.announce(msg("arena_full"), 4, true, humans[i])
	end
	local botCount = math.max(0, math.min(Config.BOT_FILL, Config.MAX_PLAYERS) - #participants)
	for _, bot in ipairs(Bots.get(botCount)) do
		participants[#participants + 1] = bot
	end

	if matchOver then
		-- a new match: everyone back to 0 round wins
		matchOver = false
		roundNumber = 0
		for _, p in ipairs(Players:GetPlayers()) do
			p:SetAttribute("MatchWins", 0)
		end
		for _, bot in ipairs(Bots.all()) do
			bot:SetAttribute("MatchWins", 0)
		end
	end

	local features = Arena.build(#participants)
	Arena.resetToggles(os.clock())
	Bots.clearCharacters()
	table.clear(S.alive)
	table.clear(S.stats)
	S.roundPlayers = participants
	roundNumber += 1
	Net.set("Round", roundNumber)

	for _, plr in ipairs(humans) do
		plr:SetAttribute("InRound", false)
		plr:SetAttribute("Alive", false)
	end
	for _, plr in ipairs(participants) do
		for _, attr in ipairs({ "Color", "ColorName", "Curse" }) do
			plr:SetAttribute(attr, nil)
		end
	end

	local spawns = Grid.spawns()
	for i, plr in ipairs(participants) do
		S.stats[plr] = Powerups.newStats()
		local c = spawns[i]
		local spawnCf = CFrame.new(Grid.cellPos(c[1], c[2]) + Vector3.new(0, 3, 0))
		local char
		if S.isBot(plr) then
			char = Bots.spawn(plr, spawnCf)
		else
			local ok = pcall(function()
				plr:LoadCharacter()
			end)
			char = ok and plr.Character
		end
		if char then
			local root = char:WaitForChild("HumanoidRootPart", 5)
			local hum = char:WaitForChild("Humanoid", 5)
			if root and hum then
				local pc = Config.PLAYER_COLORS[i]
				char:PivotTo(spawnCf)
				hum.UseJumpPower = true
				hum.JumpPower = 0
				colorCharacter(char, pc.color)
				plr:SetAttribute("Color", pc.color)
				plr:SetAttribute("ColorName", pc.name) -- a Lang key, e.g. "color_1"
				plr:SetAttribute("InRound", true)
				setAlive(plr, true)
				S.stats[plr].invulUntil = os.clock() + 2
				local ff = Instance.new("ForceField")
				ff.Parent = char
				Debris:AddItem(ff, 2)
				hum.Died:Connect(function()
					onDeath(plr)
				end)
				Powerups.sync(plr)
			end
		end
	end

	S.roundState = "playing"
	Net.set("RoundEndsAt", workspace:GetServerTimeNow() + Config.ROUND_TIME)
	Net.set("SuddenDeath", false)
	Net.set("State", "playing")
	Net.announce(msg("go"), 1.5)
	Sounds.play("Go")
	if #features > 0 then
		task.delay(1.6, function()
			Net.announce(msg("this_round", { list = features }), 3, true)
		end)
	end
	checkRound()
end

task.spawn(function()
	while true do
		while #Players:GetPlayers() == 0 do
			task.wait(1)
		end
		S.roundState = "lobby"
		Net.set("State", "lobby")
		for i = 3, 1, -1 do
			Net.announce(msg("countdown", { n = i }), 1)
			Sounds.play("Beep")
			task.wait(1)
		end
		startRound()
		local deadline = os.clock() + Config.ROUND_TIME
		local sudden = false
		while S.roundState == "playing" do
			if not sudden and os.clock() >= deadline then
				sudden = true
				task.spawn(suddenDeath)
			end
			checkRound()
			task.wait(0.25)
		end
		task.wait(Config.INTERMISSION)
	end
end)

----------------------------------------------------------------------
-- Players
----------------------------------------------------------------------
Players.PlayerAdded:Connect(function(plr)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local wins = Instance.new("IntValue")
	wins.Name = "Wins"
	wins.Parent = ls
	ls.Parent = plr
	plr:SetAttribute("Alive", false)
	plr:SetAttribute("InRound", false)
end)

Players.PlayerRemoving:Connect(function(plr)
	local s = S.stats[plr]
	if s and s.held then
		Bombs.explode(s.held)
	end
	S.alive[plr] = nil
	S.stats[plr] = nil
	-- (the player stays in roundPlayers, so the last one standing still wins)
	updateAliveCount()
	checkRound()
end)

----------------------------------------------------------------------
-- Main loop
----------------------------------------------------------------------
-- Warp zones: whoever stands (almost) in the middle of a warp comes out at the other one
local function updateWarps(now)
	if next(S.warps) == nil then
		return
	end
	for plr in pairs(S.alive) do
		local s = S.stats[plr]
		local root = S.getRoot(plr)
		local char = S.charOf(plr)
		if s and root and char then
			local x, z = Grid.cellOf(root.Position)
			local k = Grid.key(x, z)
			if s.warpCell and s.warpCell ~= k then
				s.warpCell = nil -- stepped off the warp: it works again
			end
			local w = S.warps[k]
			if w and not s.warpCell and now >= (s.warpReady or 0) and not S.terrain[k] and not S.terrain[Grid.key(w.x, w.z)] then
				local c = Grid.cellPos(x, z)
				local off = Vector3.new(root.Position.X - c.X, 0, root.Position.Z - c.Z)
				if off.Magnitude < Grid.T * 0.3 then
					local look = root.CFrame.LookVector
					local dest = Grid.cellPos(w.x, w.z) + Vector3.new(0, root.Position.Y, 0)
					char:PivotTo(CFrame.lookAt(dest, dest + Vector3.new(look.X, 0, look.Z)))
					s.warpCell = Grid.key(w.x, w.z)
					s.warpReady = now + Config.WARP_COOLDOWN
					Sounds.play("Warp", dest)
				end
			end
		end
	end
end

RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	Bombs.update(now, dt)
	Bombs.updateFlames(now)
	Powerups.update(now)
	Arena.updateToggles(now)
	updateWarps(now)
	Bots.update(now, dt)

	-- 💩 curse: drops bombs by itself
	for plr in pairs(S.alive) do
		local s = S.stats[plr]
		if s and s.curse == "autobomb" then
			Bombs.place(plr, true)
		end
	end
end)
]]></ProtectedString>
</Properties></Item><Item class="Folder" referent="RBX16"><Properties><string name="Name">Bomberman</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties>
<string name="Name">Arena</string>
<ProtectedString name="Source"><![CDATA[-- Arena: floor, walls, crates, special cells (warps, belts, switch walls),
-- the random theme of each round and the walls that drop during sudden death
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage:WaitForChild("BombConfig"))
local Grid = require(script.Parent.Grid)
local S = require(script.Parent.State)
local Net = require(script.Parent.Net)
local Powerups = require(script.Parent.Powerups)
local Sounds = require(script.Parent.Sounds)

local T = Grid.T
local key = Grid.key
local Arena = {}

local Lighting = game:GetService("Lighting")

-- Themes: each round picks one at random so the arena doesn't always look the same
local THEMES = {
	{
		name = "Grass",
		floor = { Color3.fromRGB(96, 168, 90), Color3.fromRGB(80, 148, 76) }, floorMat = Enum.Material.Grass,
		wall = Color3.fromRGB(110, 110, 120), wallMat = Enum.Material.Concrete,
		crate = Color3.fromRGB(176, 124, 70), crateMat = Enum.Material.WoodPlanks,
		rim = Color3.fromRGB(60, 60, 72), rimMat = Enum.Material.Slate,
		clock = 14, ambient = Color3.fromRGB(110, 110, 110),
	},
	{
		name = "Desert",
		floor = { Color3.fromRGB(226, 196, 132), Color3.fromRGB(212, 180, 116) }, floorMat = Enum.Material.Sand,
		wall = Color3.fromRGB(176, 120, 80), wallMat = Enum.Material.Sandstone,
		crate = Color3.fromRGB(120, 160, 80), crateMat = Enum.Material.Grass, -- cactus-coloured bushes
		rim = Color3.fromRGB(150, 100, 64), rimMat = Enum.Material.Sandstone,
		clock = 16.5, ambient = Color3.fromRGB(140, 120, 100),
	},
	{
		name = "Snow",
		floor = { Color3.fromRGB(235, 242, 250), Color3.fromRGB(215, 228, 242) }, floorMat = Enum.Material.Snow,
		wall = Color3.fromRGB(140, 190, 230), wallMat = Enum.Material.Ice,
		crate = Color3.fromRGB(190, 120, 80), crateMat = Enum.Material.WoodPlanks,
		rim = Color3.fromRGB(110, 150, 190), rimMat = Enum.Material.Glacier,
		clock = 12, ambient = Color3.fromRGB(150, 160, 180),
	},
	{
		name = "Lava",
		floor = { Color3.fromRGB(70, 60, 60), Color3.fromRGB(58, 50, 50) }, floorMat = Enum.Material.Basalt,
		wall = Color3.fromRGB(40, 36, 40), wallMat = Enum.Material.Basalt,
		crate = Color3.fromRGB(200, 80, 30), crateMat = Enum.Material.CrackedLava,
		rim = Color3.fromRGB(255, 90, 20), rimMat = Enum.Material.Neon,
		clock = 19, ambient = Color3.fromRGB(120, 70, 60),
	},
	{
		name = "Space",
		floor = { Color3.fromRGB(40, 36, 70), Color3.fromRGB(32, 28, 58) }, floorMat = Enum.Material.SmoothPlastic,
		wall = Color3.fromRGB(120, 110, 200), wallMat = Enum.Material.Metal,
		crate = Color3.fromRGB(80, 200, 220), crateMat = Enum.Material.Glass,
		rim = Color3.fromRGB(170, 80, 255), rimMat = Enum.Material.Neon,
		clock = 0, ambient = Color3.fromRGB(110, 100, 150),
	},
}
local theme = THEMES[1]
local WARP_COLORS = { Color3.fromRGB(170, 80, 255), Color3.fromRGB(40, 220, 255) }
local TOGGLE_COLOR = Color3.fromRGB(230, 90, 60)

-- Cells around the spawn points stay empty so nobody starts boxed in
local function isSafe(x, z, spawns)
	for _, c in ipairs(spawns) do
		local ax, az = math.abs(x - c[1]), math.abs(z - c[2])
		if (az == 0 and ax <= 2) or (ax == 0 and az <= 2) or (ax == 2 and az == 1) or (ax == 1 and az == 2) then
			return true
		end
	end
	return false
end

local function isFixedWall(x, z)
	return x % 2 == 0 and z % 2 == 0
end

local function makePart(size, pos, color, material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.Position = pos
	p.Color = color
	p.Material = material
	p.Parent = S.arena
	return p
end

----------------------------------------------------------------------
-- Planning the special cells (they scale with the arena size)
----------------------------------------------------------------------
local function planWarps(reserved)
	local W, H = Grid.W, Grid.H
	local xq, zq = Grid.odd(W / 4), Grid.odd(H / 4)
	local pairs_ = {
		{ { xq, zq }, { W + 1 - xq, H + 1 - zq } },
		{ { W + 1 - xq, zq }, { xq, H + 1 - zq } },
	}
	for i, pr in ipairs(pairs_) do
		local a, b = pr[1], pr[2]
		S.warps[key(a[1], a[2])] = { x = b[1], z = b[2], pair = i }
		S.warps[key(b[1], b[2])] = { x = a[1], z = a[2], pair = i }
		reserved[key(a[1], a[2])] = true
		reserved[key(b[1], b[2])] = true
	end
end

local function planBelts(reserved)
	local W, H, XM, ZM = Grid.W, Grid.H, Grid.XM, Grid.ZM
	-- one belt through the middle row, and in big arenas one through the middle column too
	local dx = math.random() < 0.5 and 1 or -1
	for x = 3, W - 2 do
		local k = key(x, ZM)
		if not reserved[k] then
			S.belts[k] = { dx = dx, dz = 0 }
			reserved[k] = true
		end
	end
	if W >= 21 then
		local dz = math.random() < 0.5 and 1 or -1
		for z = 3, H - 2 do
			local k = key(XM, z)
			if not reserved[k] then
				S.belts[k] = { dx = 0, dz = dz }
				reserved[k] = true
			end
		end
	end
end

local function planToggles(reserved)
	local XM, ZM = Grid.XM, Grid.ZM
	local cells = { { XM - 2, ZM - 2 }, { XM + 2, ZM - 2 }, { XM - 2, ZM + 2 }, { XM + 2, ZM + 2 } }
	if Grid.W >= 21 then
		for _, c in ipairs({ { XM - 4, ZM - 2 }, { XM + 4, ZM - 2 }, { XM - 4, ZM + 2 }, { XM + 4, ZM + 2 } }) do
			cells[#cells + 1] = c
		end
	end
	for _, c in ipairs(cells) do
		local k = key(c[1], c[2])
		if Grid.inBounds(c[1], c[2]) and not isFixedWall(c[1], c[2]) and not reserved[k] then
			S.toggles[k] = { x = c[1], z = c[2], up = false, closed = false }
			reserved[k] = true
		end
	end
end

-- Ice: a few small patches (a seed cell plus its neighbours). Crates may sit on ice.
local function planIce(reserved)
	local open = {}
	for x = 1, Grid.W do
		for z = 1, Grid.H do
			if not isFixedWall(x, z) and not reserved[key(x, z)] then
				open[#open + 1] = { x, z }
			end
		end
	end
	local target = math.floor(#open * Config.ICE_SHARE)
	local count, tries = 0, 0
	while count < target and tries < 200 do
		tries += 1
		local c = open[math.random(#open)]
		for _, d in ipairs({ { 0, 0 }, { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			local x, z = c[1] + d[1], c[2] + d[2]
			local k = key(x, z)
			if Grid.inBounds(x, z) and not isFixedWall(x, z) and not reserved[k] and not S.ice[k] then
				S.ice[k] = true
				count += 1
			end
		end
	end
end

----------------------------------------------------------------------
-- Building the parts
----------------------------------------------------------------------
local function buildWarp(x, z, pair)
	local color = WARP_COLORS[pair] or WARP_COLORS[1]
	local pad = makePart(Vector3.new(0.3, T - 0.6, T - 0.6), Grid.cellPos(x, z) + Vector3.new(0, 0.15, 0), color, Enum.Material.Neon)
	pad.Name = "Warp"
	pad.Shape = Enum.PartType.Cylinder
	pad.Orientation = Vector3.new(0, 0, 90)
	pad.CanCollide = false
	pad.CanQuery = false
	local att = Instance.new("Attachment")
	att.Parent = pad
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 18
	pe.Lifetime = NumberRange.new(0.6, 1)
	pe.Speed = NumberRange.new(4, 6)
	pe.EmissionDirection = Enum.NormalId.Right -- because of the rotation this is "up"
	pe.SpreadAngle = Vector2.new(15, 15)
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(color)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = att
end

local function buildBelt(x, z, b)
	local pos = Grid.cellPos(x, z)
	local base = makePart(Vector3.new(T, 0.2, T), pos + Vector3.new(0, 0.1, 0), Color3.fromRGB(45, 45, 55), Enum.Material.DiamondPlate)
	base.Name = "Belt"
	base.CanCollide = false
	base.CanQuery = false
	-- glowing stripes that slide over the belt in its direction
	local dir = Vector3.new(b.dx, 0, b.dz)
	local across = b.dx ~= 0 and Vector3.new(0.4, 0.06, T - 0.6) or Vector3.new(T - 0.6, 0.06, 0.4)
	for i = 0, 1 do
		local stripe = makePart(across, pos + Vector3.new(0, 0.23, 0) - dir * (T / 2 - 0.3), Color3.fromRGB(255, 210, 60), Enum.Material.Neon)
		stripe.Name = "BeltStripe"
		stripe.CanCollide = false
		stripe.CanQuery = false
		local tween = TweenService:Create(stripe, TweenInfo.new(T / Config.BELT_SPEED, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), {
			Position = pos + Vector3.new(0, 0.23, 0) + dir * (T / 2 - 0.3),
		})
		task.delay(i * (T / Config.BELT_SPEED) / 2, function()
			if stripe.Parent then
				tween:Play()
			end
		end)
	end
end

local function toggleDownPos(x, z)
	return Grid.cellPos(x, z) + Vector3.new(0, -T / 2 + 0.15, 0)
end

local function buildToggle(tg)
	local p = makePart(Vector3.new(T - 0.1, T, T - 0.1), toggleDownPos(tg.x, tg.z), TOGGLE_COLOR, Enum.Material.Metal)
	p.Name = "ToggleWall"
	p.CanCollide = false
	tg.part = p
end

function Arena.build(playerCount)
	if S.arena then
		S.arena:Destroy()
	end
	S.gen += 1
	for _, t in ipairs({ S.terrain, S.crateParts, S.bombs, S.bombAt, S.powerups, S.flames, S.warps, S.belts, S.toggles, S.ice }) do
		table.clear(t)
	end

	local W, H = Grid.sizeFor(playerCount)
	Grid.setSize(W, H)

	theme = THEMES[math.random(#THEMES)]
	Lighting.ClockTime = theme.clock
	Lighting.Ambient = theme.ambient
	Lighting.OutdoorAmbient = theme.ambient

	S.arena = Instance.new("Folder")
	S.arena.Name = "Arena"
	S.arena.Parent = workspace

	-- pick a theme and the special cells for this round
	local reserved = {}
	local features = {}
	for name, chance in pairs(Config.FEATURE_CHANCE) do
		features[name] = math.random() < chance
	end
	if features.Warps then
		planWarps(reserved)
	end
	if features.Belts then
		planBelts(reserved)
	end
	if features.Toggles then
		planToggles(reserved)
	end
	if features.Ice then
		planIce(reserved)
	end

	local spawns = Grid.spawns()
	local light, dark = theme.floor[1], theme.floor[2]
	for x = 1, W do
		for z = 1, H do
			local k = key(x, z)
			local floor = makePart(Vector3.new(T, 1, T), Grid.cellPos(x, z) + Vector3.new(0, -0.5, 0), (x + z) % 2 == 0 and light or dark, theme.floorMat)
			floor.Name = "Floor"
			if S.ice[k] then
				floor.Color = Color3.fromRGB(170, 220, 255)
				floor.Material = Enum.Material.Ice
				floor.Reflectance = 0.25
			end
			if isFixedWall(x, z) then
				S.terrain[k] = "wall"
				local w = makePart(Vector3.new(T, T, T), Grid.cellPos(x, z) + Vector3.new(0, T / 2, 0), theme.wall, theme.wallMat)
				w.Name = "Wall"
			elseif not reserved[k] and not isSafe(x, z, spawns) and math.random() < Config.CRATE_CHANCE then
				S.terrain[k] = "crate"
				local c = makePart(Vector3.new(T - 0.1, T - 0.1, T - 0.1), Grid.cellPos(x, z) + Vector3.new(0, T / 2, 0), theme.crate, theme.crateMat)
				c.Name = "Crate"
				S.crateParts[k] = c
			end
		end
	end

	for k, w in pairs(S.warps) do
		local x, z = Grid.unkey(k)
		buildWarp(x, z, w.pair)
	end
	local beltList = {}
	for k, b in pairs(S.belts) do
		local x, z = Grid.unkey(k)
		buildBelt(x, z, b)
		beltList[#beltList + 1] = string.format("%d,%d,%d,%d", x, z, b.dx, b.dz)
	end
	for _, tg in pairs(S.toggles) do
		buildToggle(tg)
	end

	-- outer rim
	local hw, hh = W * T / 2, H * T / 2
	local rim, rimMat = theme.rim, theme.rimMat
	makePart(Vector3.new(W * T + 2 * T, 2 * T, T), Vector3.new(0, T, -hh - T / 2), rim, rimMat)
	makePart(Vector3.new(W * T + 2 * T, 2 * T, T), Vector3.new(0, T, hh + T / 2), rim, rimMat)
	makePart(Vector3.new(T, 2 * T, H * T), Vector3.new(-hw - T / 2, T, 0), rim, rimMat)
	makePart(Vector3.new(T, 2 * T, H * T), Vector3.new(hw + T / 2, T, 0), rim, rimMat)

	-- clients need the size and the belts (camera, corner assist, being pushed)
	Net.set("ArenaW", W)
	Net.set("ArenaH", H)
	Net.set("Belts", table.concat(beltList, ";"))
	local iceList = {}
	for k in pairs(S.ice) do
		local x, z = Grid.unkey(k)
		iceList[#iceList + 1] = x .. "," .. z
	end
	Net.set("Ice", table.concat(iceList, ";"))

	local names = {}
	if features.Warps then
		names[#names + 1] = { k = "feat_warps" }
	end
	if features.Belts then
		names[#names + 1] = { k = "feat_belts" }
	end
	if features.Toggles then
		names[#names + 1] = { k = "feat_toggles" }
	end
	if features.Ice then
		names[#names + 1] = { k = "feat_ice" }
	end
	return names
end

local function removeCratePart(k)
	local part = S.crateParts[k]
	S.crateParts[k] = nil
	if part then
		TweenService:Create(part, TweenInfo.new(0.3), { Transparency = 1, Size = part.Size * 0.6 }):Play()
		Debris:AddItem(part, 0.4)
	end
end

function Arena.destroyCrate(x, z)
	local k = key(x, z)
	S.terrain[k] = nil
	removeCratePart(k)
	if math.random() < Config.DROP_CHANCE then
		local kind = Powerups.pick()
		local myGen = S.gen
		task.delay(Config.FLAME_TIME + 0.05, function()
			if myGen == S.gen and not S.terrain[k] and not S.powerups[k] and not S.bombAt[k] then
				Powerups.spawn(x, z, kind)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Switch walls: every TOGGLE_INTERVAL seconds they all go up or down.
-- A wall only rises when nobody (and no bomb) is on its cell.
----------------------------------------------------------------------
local togglePhaseUp, nextToggle = false, 0

function Arena.resetToggles(now)
	togglePhaseUp = false
	nextToggle = now + Config.TOGGLE_INTERVAL
end

function Arena.updateToggles(now)
	if next(S.toggles) == nil then
		return
	end
	if now >= nextToggle then
		togglePhaseUp = not togglePhaseUp
		nextToggle = now + Config.TOGGLE_INTERVAL
		for _, tg in pairs(S.toggles) do
			tg.pending = true
		end
	end
	for k, tg in pairs(S.toggles) do
		if tg.pending and not tg.closed then
			if togglePhaseUp then
				-- wait until the cell is empty
				if not S.bombAt[k] and not S.playerOnCell(Grid.cellOf, tg.x, tg.z) then
					tg.pending = false
					tg.up = true
					S.terrain[k] = "wall"
					Powerups.remove(k)
					tg.part.CanCollide = true
					TweenService:Create(tg.part, TweenInfo.new(0.3, Enum.EasingStyle.Back), {
						Position = Grid.cellPos(tg.x, tg.z) + Vector3.new(0, T / 2, 0),
					}):Play()
					Sounds.play("Toggle", tg.part.Position)
				end
			else
				tg.pending = false
				if tg.up then
					tg.up = false
					S.terrain[k] = nil
					tg.part.CanCollide = false
					TweenService:Create(tg.part, TweenInfo.new(0.3), { Position = toggleDownPos(tg.x, tg.z) }):Play()
				end
			end
		end
	end
end

-- Sudden death: drop a wall block on this cell. Returns false if a fixed wall was already there.
function Arena.closeCell(x, z)
	local k = key(x, z)
	local tg = S.toggles[k]
	if tg then
		tg.closed = true
		if tg.part then
			tg.part:Destroy()
		end
	elseif S.terrain[k] == "wall" then
		return false
	end
	if S.terrain[k] == "crate" then
		removeCratePart(k)
	end
	S.terrain[k] = "wall"
	Powerups.remove(k)

	local target = Grid.cellPos(x, z) + Vector3.new(0, T / 2, 0)
	local w = makePart(Vector3.new(T, T, T), target + Vector3.new(0, 24, 0), Color3.fromRGB(150, 60, 60), Enum.Material.Concrete)
	w.Name = "DeathWall"
	w.CanCollide = false
	TweenService:Create(w, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = target }):Play()
	task.delay(0.25, function()
		if w.Parent then
			w.CanCollide = true
		end
	end)
	Sounds.play("Wall", target)
	return true
end

return Arena
]]></ProtectedString>
</Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties>
<string name="Name">Bombs</string>
<ProtectedString name="Source"><![CDATA[-- Bombs: placing, throwing, kicking, exploding, and the fire
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage:WaitForChild("BombConfig"))
local Grid = require(script.Parent.Grid)
local S = require(script.Parent.State)
local Powerups = require(script.Parent.Powerups)
local Arena = require(script.Parent.Arena)
local Sounds = require(script.Parent.Sounds)

local T = Grid.T
local key = Grid.key
local BOMB_Y = Vector3.new(0, 1.6, 0)

local Bombs = {}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

-- Is this cell already the landing spot of a thrown bomb?
local function isTargeted(x, z)
	for b in pairs(S.bombs) do
		if b.state == "flying" and b.x == x and b.z == z then
			return true
		end
	end
	return false
end

-- Free cell for a bomb: no wall/crate, no other bomb (and optionally no player)
local function cellFree(x, z, checkPlayers)
	if not Grid.inBounds(x, z) then
		return false
	end
	local k = key(x, z)
	if S.terrain[k] or S.bombAt[k] or isTargeted(x, z) then
		return false
	end
	if checkPlayers and S.playerOnCell(Grid.cellOf, x, z) then
		return false
	end
	return true
end

local function newBombPart()
	local p = Instance.new("Part")
	p.Name = "Bomb"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(3.2, 3.2, 3.2)
	p.Material = Enum.Material.Metal
	p.Color = Color3.fromRGB(25, 25, 30)
	p.Anchored = true
	p.CanCollide = false

	-- Only the mesh pulses; the part's collision shape stays the same
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
	TweenService:Create(mesh, TweenInfo.new(0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Scale = Vector3.new(1.16, 1.16, 1.16),
	}):Play()

	local att = Instance.new("Attachment")
	att.Position = Vector3.new(0, 1.6, 0)
	att.Parent = p
	local sparks = Instance.new("ParticleEmitter")
	sparks.Rate = 40
	sparks.Lifetime = NumberRange.new(0.2, 0.4)
	sparks.Speed = NumberRange.new(4, 7)
	sparks.SpreadAngle = Vector2.new(180, 180)
	sparks.LightEmission = 1
	sparks.Color = ColorSequence.new(Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 80, 20))
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparks.Parent = att
	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(255, 90, 40)
	pl.Range = 8
	pl.Parent = p

	TweenService:Create(p, TweenInfo.new(Config.FUSE, Enum.EasingStyle.Linear), { Color = Color3.fromRGB(210, 30, 30) }):Play()
	p.Parent = S.arena
	return p
end

local function spawnBomb(player, x, z)
	local s = S.stats[player]
	local part = newBombPart()
	part.Position = Grid.cellPos(x, z) + BOMB_Y
	local bomb = {
		owner = player,
		holder = nil,
		x = x,
		z = z,
		range = s.range,
		pierce = s.pierce,
		explodeAt = os.clock() + Config.FUSE,
		state = "placed", -- placed | held | flying | sliding
		solid = false,
		part = part,
	}
	S.bombAt[key(x, z)] = bomb
	S.bombs[bomb] = true
	s.active += 1
	Sounds.play("Place", part.Position)
end

local function spawnFlame(x, z)
	local f = Instance.new("Part")
	f.Name = "Flame"
	f.Anchored = true
	f.CanCollide = false
	f.CanTouch = false
	f.CanQuery = false
	f.Material = Enum.Material.Neon
	f.Color = Color3.fromRGB(255, 140, 30)
	f.Size = Vector3.new(T - 0.8, 2.4, T - 0.8)
	f.Position = Grid.cellPos(x, z) + Vector3.new(0, 1.2, 0)
	f.Transparency = 0.05
	f.Parent = S.arena
	TweenService:Create(f, TweenInfo.new(Config.FLAME_TIME), { Transparency = 1 }):Play()
	Debris:AddItem(f, Config.FLAME_TIME + 0.1)
end

----------------------------------------------------------------------
-- Exploding
----------------------------------------------------------------------
function Bombs.explode(bomb)
	if bomb.exploded then
		return
	end
	bomb.exploded = true
	S.bombs[bomb] = nil
	local k = key(bomb.x, bomb.z)
	if S.bombAt[k] == bomb then
		S.bombAt[k] = nil
	end
	local os_ = S.stats[bomb.owner]
	if os_ then
		os_.active = math.max(0, os_.active - 1)
	end
	if bomb.holder then
		local hs = S.stats[bomb.holder]
		if hs and hs.held == bomb then
			hs.held = nil
		end
	end
	local center = bomb.part.Position
	bomb.part:Destroy()

	-- Roblox explosion just for looks and sound (does no damage)
	local e = Instance.new("Explosion")
	e.Position = center
	e.BlastRadius = 3
	e.BlastPressure = 0
	e.DestroyJointRadiusPercent = 0
	e.ExplosionType = Enum.ExplosionType.NoCraters
	e.Parent = S.arena
	Sounds.play("Explosion", center)

	local cells = { { bomb.x, bomb.z } }
	local chain = {}
	for _, d in ipairs(Grid.DIRS) do
		for i = 1, bomb.range do
			local cx, cz = bomb.x + d[1] * i, bomb.z + d[2] * i
			if not Grid.inBounds(cx, cz) then
				break
			end
			local ck = key(cx, cz)
			local t = S.terrain[ck]
			if t == "wall" then
				break
			elseif t == "crate" then
				Arena.destroyCrate(cx, cz)
				cells[#cells + 1] = { cx, cz }
				if not bomb.pierce then
					break
				end
			else
				cells[#cells + 1] = { cx, cz }
				if S.powerups[ck] then
					Powerups.remove(ck)
				end
				local ob = S.bombAt[ck]
				if ob then
					chain[#chain + 1] = ob
					break
				end
			end
		end
	end

	local set = {}
	for _, c in ipairs(cells) do
		set[key(c[1], c[2])] = true
		spawnFlame(c[1], c[2])
	end
	S.flames[#S.flames + 1] = { cells = set, expires = os.clock() + Config.FLAME_TIME }

	for _, ob in ipairs(chain) do
		Bombs.explode(ob)
	end
end

----------------------------------------------------------------------
-- Player actions
----------------------------------------------------------------------
local function rateLimited(s)
	if os.clock() - s.lastAction < 0.15 then
		return true
	end
	s.lastAction = os.clock()
	return false
end

-- force = true: for the "auto bombs" curse and bots (no rate limit)
function Bombs.place(player, force)
	local s = S.stats[player]
	if not s or not S.alive[player] or S.roundState ~= "playing" then
		return
	end
	if s.curse == "nobombs" then
		return
	end
	if not force and rateLimited(s) then
		return
	end
	if s.active >= s.maxBombs then
		return
	end
	local root = S.getRoot(player)
	if not root then
		return
	end
	local x, z = Grid.cellOf(root.Position)
	if not cellFree(x, z, false) then
		return
	end
	spawnBomb(player, x, z)
end

-- Send a bomb flying from cell (sx, sz) in direction (dx, dz), landing at least
-- minDist cells away. Over the outer wall it comes back in on the opposite side.
-- Returns false when there is no free landing cell.
local function launch(bomb, sx, sz, dx, dz, minDist)
	local tx, tz
	local wrapped = false
	local size = dx ~= 0 and Grid.W or Grid.H
	for step = minDist, size - 1 do
		local cx, cz = sx + dx * step, sz + dz * step
		local w = not Grid.inBounds(cx, cz)
		cx = (cx - 1) % Grid.W + 1
		cz = (cz - 1) % Grid.H + 1
		if cellFree(cx, cz, false) then
			tx, tz, wrapped = cx, cz, w
			break
		end
	end
	if not tx then
		for step = minDist - 1, 1, -1 do
			local cx, cz = sx + dx * step, sz + dz * step
			if cellFree(cx, cz, false) then
				tx, tz = cx, cz
				break
			end
		end
	end
	if not tx then
		return false
	end
	bomb.state = "flying"
	bomb.solid = false
	bomb.part.CanCollide = false
	-- Note: while flying the bomb is NOT in bombAt, so fire can't
	-- set it off in mid-air. It lands on (x, z).
	bomb.x, bomb.z = tx, tz
	local from = bomb.part.Position
	local to = Grid.cellPos(tx, tz) + BOMB_Y
	if wrapped then
		-- two pieces: to just past the edge, then from the opposite side to the target
		local exitPos, entryPos
		if dx ~= 0 then
			exitPos = Vector3.new(Grid.cellPos(dx > 0 and Grid.W + 1.5 or -0.5, sz).X, from.Y, from.Z)
			entryPos = Vector3.new(Grid.cellPos(dx > 0 and -0.5 or Grid.W + 1.5, sz).X, to.Y, to.Z)
		else
			exitPos = Vector3.new(from.X, from.Y, Grid.cellPos(sx, dz > 0 and Grid.H + 1.5 or -0.5).Z)
			entryPos = Vector3.new(to.X, to.Y, Grid.cellPos(sx, dz > 0 and -0.5 or Grid.H + 1.5).Z)
		end
		bomb.path = { { from, exitPos, "up" }, { entryPos, to, "down" } }
	else
		bomb.path = { { from, to, "arc" } }
	end
	local len = 0
	for _, seg in ipairs(bomb.path) do
		len += (seg[2] - seg[1]).Magnitude
	end
	bomb.pathLen = len
	bomb.t0 = os.clock()
	bomb.dur = math.max(0.35, len / Config.THROW_SPEED)
	Sounds.play("Throw", from)
	return true
end

-- The action button (E / 🧤). In order of priority:
--   holding a bomb      -> throw it
--   🦶 and your kicked bomb is sliding -> stop it on the next cell
--   🥊 and a bomb in front of you      -> punch it over the walls
--   🧤 and a bomb under / in front of you -> pick it up
function Bombs.throw(player)
	local s = S.stats[player]
	if not s or not S.alive[player] or S.roundState ~= "playing" then
		return
	end
	if rateLimited(s) then
		return
	end
	local root = S.getRoot(player)
	if not root then
		return
	end

	local dx, dz = Grid.axisDir(root.CFrame.LookVector)
	local sx, sz = Grid.cellOf(root.Position)

	if s.held then
		local bomb = s.held
		if launch(bomb, sx, sz, dx, dz, Config.THROW_DISTANCE) then
			s.held = nil
			bomb.holder = nil
		end
		return
	end

	if s.kick then
		local stopped = false
		for b in pairs(S.bombs) do
			if b.state == "sliding" and b.kicker == player and not b.oneStep then
				b.stopNext = true
				stopped = true
			end
		end
		if stopped then
			return
		end
	end

	if s.punch then
		local k = key(sx + dx, sz + dz)
		local b = S.bombAt[k]
		if b and b.state == "placed" then
			S.bombAt[k] = nil
			if launch(b, b.x, b.z, dx, dz, Config.PUNCH_DISTANCE) then
				return
			end
			S.bombAt[k] = b -- nowhere to land: leave it
		end
	end

	if s.throw then
		for _, c in ipairs({ { sx, sz }, { sx + dx, sz + dz } }) do
			local k = key(c[1], c[2])
			local b = S.bombAt[k]
			if b and b.state == "placed" then
				S.bombAt[k] = nil
				b.state = "held"
				b.holder = player
				b.solid = false
				b.part.CanCollide = false
				s.held = b
				return
			end
		end
	end
end

-- Make a bomb slide. oneStep = true: only one cell (conveyor belt)
local function startSlide(bomb, dx, dz, speed, oneStep)
	if not cellFree(bomb.x + dx, bomb.z + dz, true) then
		return false
	end
	bomb.state = "sliding"
	bomb.dx, bomb.dz = dx, dz
	bomb.slide = 0
	bomb.slideSpeed = speed
	bomb.oneStep = oneStep
	bomb.solid = false
	bomb.part.CanCollide = false
	return true
end

local function kick(bomb, dx, dz, player)
	if startSlide(bomb, dx, dz, Config.KICK_SPEED, false) then
		bomb.kicker = player
		bomb.stopNext = false
		Sounds.play("Kick", bomb.part.Position)
	end
end

-- A sliding bomb that reaches a warp comes out at the other warp
local function warpBomb(bomb)
	local w = S.warps[key(bomb.x, bomb.z)]
	if w and not S.terrain[key(w.x, w.z)] and cellFree(w.x, w.z, false) then
		if S.bombAt[key(bomb.x, bomb.z)] == bomb then
			S.bombAt[key(bomb.x, bomb.z)] = nil
		end
		bomb.x, bomb.z = w.x, w.z
		S.bombAt[key(w.x, w.z)] = bomb
		Sounds.play("Warp", Grid.cellPos(w.x, w.z))
	end
end

-- Players with the kick shoe who walk into a bomb kick it away
local function checkKicks()
	for plr in pairs(S.alive) do
		local s = S.stats[plr]
		local root = S.getRoot(plr)
		local hum = S.getHum(plr)
		if s and s.kick and root and hum and hum.MoveDirection.Magnitude > 0.5 then
			local dx, dz = Grid.axisDir(hum.MoveDirection)
			local px, pz = Grid.cellOf(root.Position)
			local b = S.bombAt[key(px + dx, pz + dz)]
			if b and b.state == "placed" and b.solid then
				local center = Grid.cellPos(b.x, b.z)
				local along = math.abs(dx ~= 0 and (center.X - root.Position.X) or (center.Z - root.Position.Z))
				local side = math.abs(dx ~= 0 and (center.Z - root.Position.Z) or (center.X - root.Position.X))
				if along < T * 0.85 and side < T * 0.45 then
					kick(b, dx, dz, plr)
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Every frame
----------------------------------------------------------------------
function Bombs.update(now, dt)
	checkKicks()

	local list = {}
	for b in pairs(S.bombs) do
		list[#list + 1] = b
	end
	for _, bomb in ipairs(list) do
		if not bomb.exploded then
			if bomb.state == "held" then
				local root = bomb.holder and S.getRoot(bomb.holder)
				if not root or not S.alive[bomb.holder] then
					Bombs.explode(bomb)
				else
					bomb.part.Position = root.Position + Vector3.new(0, 3.6, 0)
					local x, z = Grid.cellOf(root.Position)
					bomb.x, bomb.z = math.clamp(x, 1, Grid.W), math.clamp(z, 1, Grid.H)
				end
			elseif bomb.state == "flying" then
				local a = math.clamp((now - bomb.t0) / bomb.dur, 0, 1)
				-- find which piece of the path the bomb is on
				local dist = a * bomb.pathLen
				for _, seg in ipairs(bomb.path) do
					local segLen = math.max((seg[2] - seg[1]).Magnitude, 0.001)
					if dist <= segLen or seg == bomb.path[#bomb.path] then
						local f = math.clamp(dist / segLen, 0, 1)
						local h
						if seg[3] == "up" then
							h = math.sin(math.pi / 2 * f) * 12 -- high over the outer wall
						elseif seg[3] == "down" then
							h = math.cos(math.pi / 2 * f) * 12
						else
							h = math.sin(math.pi * f) * 6
						end
						bomb.part.Position = seg[1]:Lerp(seg[2], f) + Vector3.new(0, h, 0)
						break
					end
					dist -= segLen
				end
				if a >= 1 then
					local k = key(bomb.x, bomb.z)
					if S.terrain[k] or S.bombAt[k] then
						-- a wall or bomb appeared on the landing spot in the meantime
						Bombs.explode(bomb)
					else
						S.bombAt[k] = bomb
						bomb.state = "placed"
					end
				end
			elseif bomb.state == "sliding" then
				bomb.slide += bomb.slideSpeed * dt
				while bomb.slide >= 1 and bomb.state == "sliding" do
					bomb.slide -= 1
					local k = key(bomb.x, bomb.z)
					if S.bombAt[k] == bomb then
						S.bombAt[k] = nil
					end
					bomb.x, bomb.z = bomb.x + bomb.dx, bomb.z + bomb.dz
					S.bombAt[key(bomb.x, bomb.z)] = bomb
					warpBomb(bomb)
					if bomb.oneStep or bomb.stopNext or not cellFree(bomb.x + bomb.dx, bomb.z + bomb.dz, true) then
						bomb.state = "placed"
						bomb.slide = 0
					end
				end
				local here = Grid.cellPos(bomb.x, bomb.z)
				if bomb.state == "sliding" then
					local nextPos = Grid.cellPos(bomb.x + bomb.dx, bomb.z + bomb.dz)
					bomb.part.Position = here:Lerp(nextPos, bomb.slide) + BOMB_Y
				else
					bomb.part.Position = here + BOMB_Y
				end
			elseif bomb.state == "placed" and S.belts[key(bomb.x, bomb.z)] then
				-- a bomb on a conveyor belt moves along one cell at a time
				local b = S.belts[key(bomb.x, bomb.z)]
				startSlide(bomb, b.dx, b.dz, Config.BELT_BOMB_SPEED, true)
			elseif bomb.state == "placed" and not bomb.solid then
				-- only solid once nobody stands on it (so you can walk off your own bomb)
				local clear = true
				for plr in pairs(S.alive) do
					local root = S.getRoot(plr)
					if root then
						local d = Vector3.new(root.Position.X - bomb.part.Position.X, 0, root.Position.Z - bomb.part.Position.Z)
						if d.Magnitude < 3 then
							clear = false
							break
						end
					end
				end
				if clear then
					bomb.solid = true
					bomb.part.CanCollide = true
				end
			end
			if not bomb.exploded and now >= bomb.explodeAt then
				Bombs.explode(bomb)
			end
		end
	end
end

-- Fire kills players standing in it
function Bombs.updateFlames(now)
	for i = #S.flames, 1, -1 do
		local f = S.flames[i]
		if now >= f.expires then
			table.remove(S.flames, i)
		else
			for plr in pairs(S.alive) do
				local s = S.stats[plr]
				local root = S.getRoot(plr)
				if root and s and now >= s.invulUntil then
					local x, z = Grid.cellOf(root.Position)
					if f.cells[key(x, z)] then
						local hum = S.getHum(plr)
						if hum then
							hum.Health = 0
						end
					end
				end
			end
		end
	end
end

return Bombs
]]></ProtectedString>
</Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties>
<string name="Name">Bots</string>
<ProtectedString name="Source"><![CDATA[-- Computer opponents ("bots").
-- A bot is a Folder that stands in for a Player: it is used as the key in
-- S.stats / S.alive, holds the same attributes (Color, Bombs, ...) and has a
-- leaderstats folder with Wins. Its character model is kept in S.botChars.
--
-- Every BOT_THINK seconds each bot looks at the grid and picks one goal:
--   1. standing in danger  -> walk to the nearest safe cell
--   2. goodie nearby       -> pick it up
--   3. enemy or crate in reach and an escape route exists -> place a bomb
--   4. otherwise           -> walk towards the nearest enemy / crate
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(ReplicatedStorage:WaitForChild("BombConfig"))
local Grid = require(script.Parent.Grid)
local S = require(script.Parent.State)
local Bombs = require(script.Parent.Bombs)

local key = Grid.key
local Bots = {}

local folder = Instance.new("Folder")
folder.Name = "Bots"
folder.Parent = ServerStorage

local botList = {} -- all bot Folders ever made, so their wins are kept between rounds
local brain = {} -- bot -> { nextThink, target = {x, z} }

local BOT_NAMES = { "Bommetje", "Knaller", "Vonk", "Lontje", "Boemboem", "Sissy", "Kaboom" }

----------------------------------------------------------------------
-- Creating bots
----------------------------------------------------------------------
function Bots.get(count)
	while #botList < count do
		local i = #botList + 1
		local bot = Instance.new("Folder")
		bot.Name = "Bot" .. i
		bot:SetAttribute("DisplayName", "🤖 " .. (BOT_NAMES[i] or ("Bot " .. i)))
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local wins = Instance.new("IntValue")
		wins.Name = "Wins"
		wins.Parent = ls
		ls.Parent = bot
		bot.Parent = folder
		botList[i] = bot
	end
	local out = {}
	for i = 1, count do
		out[i] = botList[i]
	end
	return out
end

function Bots.all()
	return botList
end

-- Build a character model for the bot at the given CFrame
function Bots.spawn(bot, cframe)
	local old = S.botChars[bot]
	if old then
		old:Destroy()
	end
	local desc = Instance.new("HumanoidDescription")
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("Roblomberman: could not create bot character", model)
		return nil
	end
	model.Name = bot.Name
	local hum = model:FindFirstChildOfClass("Humanoid")
	hum.DisplayName = S.nameOf(bot)
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	model.Parent = workspace
	model:PivotTo(cframe)
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		root:SetNetworkOwner(nil) -- the server moves bots
	end
	S.botChars[bot] = model
	brain[bot] = { nextThink = 0 }
	return model
end

function Bots.clearCharacters()
	for bot, model in pairs(S.botChars) do
		model:Destroy()
		S.botChars[bot] = nil
	end
	table.clear(brain)
end

----------------------------------------------------------------------
-- Grid knowledge
----------------------------------------------------------------------
-- Cells a bomb at (x, z) would hit, same rules as Bombs.explode
local function blastCells(x, z, range, pierce, out)
	out[key(x, z)] = true
	for _, d in ipairs(Grid.DIRS) do
		for i = 1, range do
			local cx, cz = x + d[1] * i, z + d[2] * i
			if not Grid.inBounds(cx, cz) then
				break
			end
			local t = S.terrain[key(cx, cz)]
			if t == "wall" then
				break
			end
			out[key(cx, cz)] = true
			if (t == "crate" and not pierce) or S.bombAt[key(cx, cz)] then
				break
			end
		end
	end
	return out
end

-- Every cell that is on fire or will be hit by a bomb that is already ticking
local function dangerMap()
	local danger = {}
	for b in pairs(S.bombs) do
		if not b.exploded then
			blastCells(b.x, b.z, b.range, b.pierce, danger)
		end
	end
	for _, f in ipairs(S.flames) do
		for k in pairs(f.cells) do
			danger[k] = true
		end
	end
	return danger
end

local function fireNow()
	local fire = {}
	for _, f in ipairs(S.flames) do
		for k in pairs(f.cells) do
			fire[k] = true
		end
	end
	return fire
end

local function walkable(x, z, fire)
	if not Grid.inBounds(x, z) then
		return false
	end
	local k = key(x, z)
	return not S.terrain[k] and not S.bombAt[k] and not fire[k]
end

-- Breadth-first search from (sx, sz). goal(x, z, k) returns true for a target cell.
-- avoid[k] = true marks cells we do not want to walk through.
-- Returns the first step {x, z} and the path length, or nil.
local function bfs(sx, sz, goal, fire, avoid, maxLen)
	local start = key(sx, sz)
	local prev = { [start] = false }
	local dist = { [start] = 0 }
	local queue = { { sx, sz } }
	local head = 1
	while head <= #queue do
		local c = queue[head]
		head += 1
		local k = key(c[1], c[2])
		if goal(c[1], c[2], k) then
			if k == start then
				return { sx, sz }, 0
			end
			-- walk back along the path to find the first step
			local cur = k
			while prev[cur].k ~= start do
				cur = prev[cur].k
			end
			return prev[cur].c, dist[k]
		end
		if dist[k] < (maxLen or 99) then
			for _, d in ipairs(Grid.DIRS) do
				local nx, nz = c[1] + d[1], c[2] + d[2]
				local nk = key(nx, nz)
				if prev[nk] == nil and walkable(nx, nz, fire) and not (avoid and avoid[nk]) then
					prev[nk] = { k = k, c = { nx, nz } }
					dist[nk] = dist[k] + 1
					queue[#queue + 1] = { nx, nz }
				end
			end
		end
	end
	return nil
end

local function enemiesInLine(bot, x, z, range)
	for _, d in ipairs(Grid.DIRS) do
		for i = 1, range do
			local cx, cz = x + d[1] * i, z + d[2] * i
			if not Grid.inBounds(cx, cz) or S.terrain[key(cx, cz)] then
				break
			end
			local p = S.playerOnCell(Grid.cellOf, cx, cz)
			if p and p ~= bot then
				return true
			end
		end
	end
	return false
end

local function crateNext(x, z)
	for _, d in ipairs(Grid.DIRS) do
		if S.terrain[key(x + d[1], z + d[2])] == "crate" then
			return true
		end
	end
	return false
end

-- Would the bot still be able to run to safety after dropping a bomb here?
local function canEscape(x, z, s, fire)
	local danger = dangerMap()
	blastCells(x, z, s.range, s.pierce, danger)
	local steps = math.floor(Config.FUSE * s.speed / Grid.T) - 1
	return bfs(x, z, function(_, _, k)
		return not danger[k]
	end, fire, nil, steps) ~= nil
end

----------------------------------------------------------------------
-- Thinking and moving
----------------------------------------------------------------------
local function think(bot, s, root, hum)
	local x, z = Grid.cellOf(root.Position)
	local fire = fireNow()
	local danger = dangerMap()
	local mem = brain[bot]
	mem.target = nil

	-- 1. get out of danger
	if danger[key(x, z)] then
		local step = bfs(x, z, function(_, _, k)
			return not danger[k]
		end, fire, nil, 20)
		mem.target = step
		return
	end

	-- 2. goodies close by (skip the skull if we can help it)
	local step = bfs(x, z, function(_, _, k)
		local pu = S.powerups[k]
		return pu ~= nil and pu.kind ~= "Skull"
	end, fire, danger, 6)
	if step then
		mem.target = step
		return
	end

	-- 3. drop a bomb next to a crate or an enemy, if we can get away
	if s.active < s.maxBombs and s.curse ~= "nobombs" and math.random() < Config.BOT_AGGRESSION then
		if (enemiesInLine(bot, x, z, s.range) or crateNext(x, z)) and canEscape(x, z, s, fire) then
			Bombs.place(bot, true)
			return -- next think will see the danger and run
		end
	end

	-- 4. walk towards an enemy, or else towards a crate
	step = bfs(x, z, function(cx, cz)
		local p = S.playerOnCell(Grid.cellOf, cx, cz)
		return (p ~= nil and p ~= bot) or (crateNext(cx, cz) and (cx ~= x or cz ~= z))
	end, fire, danger, 40)
	if step then
		mem.target = step
		return
	end

	-- 5. nothing to do: wander to a random safe neighbour
	local options = {}
	for _, d in ipairs(Grid.DIRS) do
		local nx, nz = x + d[1], z + d[2]
		if walkable(nx, nz, fire) and not danger[key(nx, nz)] then
			options[#options + 1] = { nx, nz }
		end
	end
	if #options > 0 then
		mem.target = options[math.random(#options)]
	end
end

function Bots.update(now, dt)
	for bot, model in pairs(S.botChars) do
		local s = S.stats[bot]
		local hum = model:FindFirstChildOfClass("Humanoid")
		local root = model:FindFirstChild("HumanoidRootPart")
		local mem = brain[bot]
		if S.alive[bot] and s and hum and root and mem and hum.Health > 0 and S.roundState == "playing" then
			hum.WalkSpeed = s.curse == "slow" and Config.CURSE_SLOW_SPEED or s.speed
			if now >= mem.nextThink then
				mem.nextThink = now + Config.BOT_THINK * (0.8 + math.random() * 0.4)
				think(bot, s, root, hum)
			end
			local t = mem.target
			if t then
				local goal = Grid.cellPos(t[1], t[2])
				local flat = Vector3.new(goal.X - root.Position.X, 0, goal.Z - root.Position.Z)
				if flat.Magnitude < 0.5 then
					mem.target = nil
					mem.nextThink = math.min(mem.nextThink, now) -- reached it: think again right away
					hum:Move(Vector3.zero)
				else
					hum:Move(flat.Unit)
				end
			else
				hum:Move(Vector3.zero)
			end

			-- conveyor belts push bots too (players are pushed by their own client)
			local cx, cz = Grid.cellOf(root.Position)
			local belt = S.belts[key(cx, cz)]
			if belt then
				root.CFrame += Vector3.new(belt.dx, 0, belt.dz) * Config.BELT_SPEED * dt
			end
		elseif hum then
			hum:Move(Vector3.zero)
		end
	end
end

return Bots
]]></ProtectedString>
</Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties>
<string name="Name">Grid</string>
<ProtectedString name="Source"><![CDATA[-- Grid helpers: from cell to position and back.
-- The size can change every round (Grid.setSize), depending on the number of players.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("BombConfig"))

local T = Config.TILE

local Grid = {
	T = T,
	W = 13,
	H = 13,
	DIRS = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } },
}

local originX, originZ = 0, 0

-- Nearest odd number (odd rows/columns never have fixed walls)
function Grid.odd(v)
	return math.floor((v - 1) / 2 + 0.5) * 2 + 1
end

function Grid.setSize(w, h)
	Grid.W, Grid.H = w, h
	originX = -(w - 1) * T / 2
	originZ = -(h - 1) * T / 2
	Grid.XM, Grid.ZM = Grid.odd((w + 1) / 2), Grid.odd((h + 1) / 2) -- middle
end
Grid.setSize(Grid.W, Grid.H)

-- Pick the arena size for the number of players
function Grid.sizeFor(playerCount)
	for _, row in ipairs(Config.ARENA_SIZES) do
		if playerCount <= row.players then
			return row.w, row.h
		end
	end
	local last = Config.ARENA_SIZES[#Config.ARENA_SIZES]
	return last.w, last.h
end

-- Spawn points: the four corners first, then the middle of each edge
function Grid.spawns()
	local W, H, XM, ZM = Grid.W, Grid.H, Grid.XM, Grid.ZM
	return {
		{ 1, 1 }, { W, H }, { W, 1 }, { 1, H },
		{ XM, 1 }, { XM, H }, { 1, ZM }, { W, ZM },
	}
end

function Grid.cellPos(x, z)
	return Vector3.new(originX + (x - 1) * T, 0, originZ + (z - 1) * T)
end

function Grid.cellOf(p)
	return math.floor((p.X - originX) / T + 0.5) + 1, math.floor((p.Z - originZ) / T + 0.5) + 1
end

function Grid.key(x, z)
	return x * 100 + z
end

function Grid.unkey(k)
	return k // 100, k % 100
end

function Grid.inBounds(x, z)
	return x >= 1 and x <= Grid.W and z >= 1 and z <= Grid.H
end

-- Main direction (one axis) of a vector, e.g. look or walk direction
function Grid.axisDir(v)
	if math.abs(v.X) > math.abs(v.Z) then
		return v.X > 0 and 1 or -1, 0
	end
	return 0, v.Z > 0 and 1 or -1
end

-- All cells in a spiral from the outside in (for sudden death)
function Grid.spiral()
	local out = {}
	local x1, z1, x2, z2 = 1, 1, Grid.W, Grid.H
	while x1 <= x2 and z1 <= z2 do
		for x = x1, x2 do
			out[#out + 1] = { x, z1 }
		end
		for z = z1 + 1, z2 do
			out[#out + 1] = { x2, z }
		end
		if z1 < z2 then
			for x = x2 - 1, x1, -1 do
				out[#out + 1] = { x, z2 }
			end
		end
		if x1 < x2 then
			for z = z2 - 1, z1 + 1, -1 do
				out[#out + 1] = { x1, z }
			end
		end
		x1, z1, x2, z2 = x1 + 1, z1 + 1, x2 - 1, z2 - 1
	end
	return out
end

return Grid
]]></ProtectedString>
</Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties>
<string name="Name">Net</string>
<ProtectedString name="Source"><![CDATA[-- RemoteEvents and round info for the clients
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = {}

local folder = Instance.new("Folder")
folder.Name = "BombRemotes"
Net.folder = folder

local function newRemote(name)
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = folder
	return r
end

Net.PlaceBomb = newRemote("PlaceBomb")
Net.ThrowBomb = newRemote("ThrowBomb")
Net.Announce = newRemote("Announce") -- (message, seconds, small?) – message is a Lang key table
Net.RoundResult = newRemote("RoundResult") -- (title message, rows, seconds)

-- Round info as attributes on the folder: State, RoundEndsAt, SuddenDeath, AliveCount,
-- Round, ArenaW, ArenaH, Belts
folder:SetAttribute("State", "lobby")
folder.Parent = ReplicatedStorage

function Net.announce(text, seconds, small, player)
	if player then
		if player:IsA("Player") then -- bots have no screen
			Net.Announce:FireClient(player, text, seconds or 3, small)
		end
	else
		Net.Announce:FireAllClients(text, seconds or 3, small)
	end
end

function Net.set(name, value)
	folder:SetAttribute(name, value)
end

return Net
]]></ProtectedString>
</Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties>
<string name="Name">Powerups</string>
<ProtectedString name="Source"><![CDATA[-- Goodies: what they do, spawning, picking them up, and the 💀 curses
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Config = require(ReplicatedStorage:WaitForChild("BombConfig"))
local Grid = require(script.Parent.Grid)
local S = require(script.Parent.State)
local Net = require(script.Parent.Net)
local Sounds = require(script.Parent.Sounds)

local Powerups = {}

-- Curse kinds; the text shown to players is the Lang key "curse_<kind>"
local CURSE_KINDS = { "slow", "nobombs", "autobomb" }

local DEFS = {
	Range = {
		emoji = "🔥", color = Color3.fromRGB(255, 120, 40), weight = 25,
		apply = function(s) s.range = math.min(s.range + 1, Config.MAX_RANGE) end,
	},
	Bomb = {
		emoji = "💣", color = Color3.fromRGB(90, 90, 110), weight = 25,
		apply = function(s) s.maxBombs = math.min(s.maxBombs + 1, Config.MAX_BOMBS) end,
	},
	Speed = {
		emoji = "👟", color = Color3.fromRGB(80, 200, 255), weight = 15,
		apply = function(s) s.speed = math.min(s.speed + Config.SPEED_STEP, Config.MAX_SPEED) end,
	},
	Pierce = {
		emoji = "⚡", color = Color3.fromRGB(255, 230, 60), weight = 10,
		apply = function(s) s.pierce = true end,
	},
	Throw = {
		emoji = "🧤", color = Color3.fromRGB(120, 255, 120), weight = 12,
		apply = function(s) s.throw = true end,
	},
	Kick = {
		emoji = "🦶", color = Color3.fromRGB(255, 150, 220), weight = 12,
		apply = function(s) s.kick = true end,
	},
	-- Rare ones: hard to find, and they sparkle when they do show up
	Punch = {
		emoji = "🥊", color = Color3.fromRGB(255, 60, 60), weight = 3, rare = true,
		apply = function(s) s.punch = true end,
	},
	MaxFire = {
		emoji = "🌋", color = Color3.fromRGB(255, 200, 0), weight = 2, rare = true,
		apply = function(s) s.range = Config.MAX_RANGE end,
	},
	Skull = {
		emoji = "💀", color = Color3.fromRGB(150, 60, 200), weight = 8,
		apply = function(s)
			s.curse = CURSE_KINDS[math.random(#CURSE_KINDS)]
			s.curseUntil = os.clock() + Config.CURSE_TIME
		end,
	},
}
Powerups.DEFS = DEFS
local ORDER = { "Range", "Bomb", "Speed", "Pierce", "Throw", "Kick", "Punch", "MaxFire", "Skull" }

function Powerups.pick()
	local total = 0
	for _, kind in ipairs(ORDER) do
		total += DEFS[kind].weight
	end
	local r = math.random() * total
	for _, kind in ipairs(ORDER) do
		r -= DEFS[kind].weight
		if r <= 0 then
			return kind
		end
	end
	return "Range"
end

function Powerups.newStats()
	return {
		maxBombs = Config.START_BOMBS,
		range = Config.START_RANGE,
		speed = Config.START_SPEED,
		pierce = false,
		throw = false,
		kick = false,
		punch = false,
		curse = nil,
		curseUntil = 0,
		active = 0,
		held = nil,
		lastAction = 0,
		invulUntil = 0,
	}
end

function Powerups.sync(player)
	local s = S.stats[player]
	if not s then
		return
	end
	player:SetAttribute("Bombs", s.maxBombs)
	player:SetAttribute("Range", s.range)
	player:SetAttribute("Speed", s.speed)
	player:SetAttribute("Pierce", s.pierce)
	player:SetAttribute("Throw", s.throw)
	player:SetAttribute("Kick", s.kick)
	player:SetAttribute("Punch", s.punch)
	player:SetAttribute("Curse", s.curse and ("curse_" .. s.curse) or nil)
	local hum = S.getHum(player)
	if hum then
		hum.WalkSpeed = s.curse == "slow" and Config.CURSE_SLOW_SPEED or s.speed
	end
end

function Powerups.remove(k)
	local pu = S.powerups[k]
	if pu then
		pu.part:Destroy()
		S.powerups[k] = nil
	end
end

function Powerups.spawn(x, z, kind)
	local def = DEFS[kind]
	local p = Instance.new("Part")
	p.Name = "Goodie_" .. kind
	p.Size = Vector3.new(2.4, 2.4, 2.4)
	p.Material = Enum.Material.Neon
	p.Color = def.color
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Position = Grid.cellPos(x, z) + Vector3.new(0, 2, 0)

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(64, 64)
	gui.Parent = p
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = def.emoji
	label.TextScaled = true
	label.Parent = gui

	if def.rare then
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = def.color
		sparkles.Parent = p
		p.Size = Vector3.new(2.8, 2.8, 2.8)
	end

	p.Parent = S.arena
	TweenService:Create(p, TweenInfo.new(0.7, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
		Position = Grid.cellPos(x, z) + Vector3.new(0, 2.8, 0),
	}):Play()
	S.powerups[Grid.key(x, z)] = { part = p, kind = kind }
end

-- Every frame: pick up goodies and let curses run out
function Powerups.update(now)
	for plr in pairs(S.alive) do
		local root = S.getRoot(plr)
		local s = S.stats[plr]
		if root and s then
			local x, z = Grid.cellOf(root.Position)
			local k = Grid.key(x, z)
			local pu = S.powerups[k]
			if pu then
				local def = DEFS[pu.kind]
				def.apply(s)
				Powerups.remove(k)
				Powerups.sync(plr)
				if pu.kind == "Skull" then
					Net.announce({ k = "curse_" .. s.curse }, 2.5, true, plr)
					Sounds.play("Curse", root.Position)
				else
					Net.announce({ k = "pu_" .. pu.kind }, 1.8, true, plr)
					Sounds.play("Pickup", root.Position)
				end
			end
			if s.curse and now >= s.curseUntil then
				s.curse = nil
				Powerups.sync(plr)
				Net.announce({ k = "curse_over" }, 1.8, true, plr)
			end
		end
	end
end

return Powerups
]]></ProtectedString>
</Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties>
<string name="Name">Sounds</string>
<ProtectedString name="Source"><![CDATA[-- Playing sounds (ids are in BombConfig.SOUNDS)
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local Config = require(ReplicatedStorage:WaitForChild("BombConfig"))

local Sounds = {}

local holder = Instance.new("Folder")
holder.Name = "BombSounds"
holder.Parent = workspace

-- position = nil plays the sound equally loud everywhere
function Sounds.play(name, position)
	local def = Config.SOUNDS[name]
	if not def or def.id == "" then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = def.id
	s.Volume = def.volume or 0.6
	s.PlaybackSpeed = def.speed or 1
	s.RollOffMaxDistance = 300
	s.RollOffMinDistance = 40
	if position then
		local att = Instance.new("Attachment")
		att.WorldPosition = position
		att.Parent = workspace.Terrain
		s.Parent = att
		Debris:AddItem(att, 6)
	else
		s.Parent = holder
		Debris:AddItem(s, 6)
	end
	s:Play()
end

return Sounds
]]></ProtectedString>
</Properties></Item><Item class="ModuleScript" referent="RBX8"><Properties>
<string name="Name">State</string>
<ProtectedString name="Source"><![CDATA[-- Shared game state (one table all modules use)
local State = {
	arena = nil, -- Folder with all parts of the current arena
	gen = 0, -- goes up with every new arena, so old timers stop doing anything
	terrain = {}, -- key -> "wall" | "crate"
	crateParts = {}, -- key -> Part
	bombs = {}, -- set of bombs
	bombAt = {}, -- key -> bomb lying on that cell
	powerups = {}, -- key -> { part, kind }
	flames = {}, -- list of { cells = {key=true}, expires }
	warps = {}, -- key -> { x, z } of the other warp
	belts = {}, -- key -> { dx, dz }
	toggles = {}, -- key -> { x, z, part, up, closed }
	ice = {}, -- key -> true
	stats = {}, -- player -> stats
	alive = {}, -- player -> true
	roundPlayers = {}, -- players (and bots) in this round
	roundState = "lobby", -- lobby | playing | over
}

-- Bots are Folder instances (not Players); their character models live here
State.botChars = {} -- bot Folder -> Model

function State.isBot(p)
	return not p:IsA("Player")
end

function State.charOf(p)
	if p:IsA("Player") then
		return p.Character
	end
	return State.botChars[p]
end

function State.nameOf(p)
	if p:IsA("Player") then
		return p.DisplayName
	end
	return p:GetAttribute("DisplayName") or p.Name
end

function State.getRoot(player)
	local c = State.charOf(player)
	return c and c:FindFirstChild("HumanoidRootPart")
end

function State.getHum(player)
	local c = State.charOf(player)
	return c and c:FindFirstChildOfClass("Humanoid")
end

-- Is a living player on this cell?
function State.playerOnCell(cellOf, x, z)
	for plr in pairs(State.alive) do
		local root = State.getRoot(plr)
		if root then
			local px, pz = cellOf(root.Position)
			if px == x and pz == z then
				return plr
			end
		end
	end
	return nil
end

return State
]]></ProtectedString>
</Properties></Item></Item></Item>
<Item class="StarterPlayer" referent="RBX20"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX19"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX18"><Properties>
<string name="Name">BombermanClient</string>
<ProtectedString name="Source"><![CDATA[-- Roblomberman: client (top-down camera, HUD, buttons, corner assist, belts).
-- All text goes through Lang, in the language the player set in Roblox.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")
local LocalizationService = game:GetService("LocalizationService")

local Config = require(ReplicatedStorage:WaitForChild("BombConfig"))
local Lang = require(ReplicatedStorage:WaitForChild("Lang"))
local remotes = ReplicatedStorage:WaitForChild("BombRemotes")
local placeRemote = remotes:WaitForChild("PlaceBomb")
local throwRemote = remotes:WaitForChild("ThrowBomb")
local announceRemote = remotes:WaitForChild("Announce")
local resultRemote = remotes:WaitForChild("RoundResult")

local player = Players.LocalPlayer

local okLocale, localeId = pcall(function()
	return LocalizationService.RobloxLocaleId
end)
local lang = Lang.pick(okLocale and localeId or player.LocaleId)
local function tr(msg, args)
	return Lang.t(lang, msg, args)
end
local camera = workspace.CurrentCamera
camera.FieldOfView = 40

local T = Config.TILE

-- The arena changes size every round; the server puts the size on the remotes folder
local arenaW, arenaH = 13, 13
local originX, originZ = 0, 0
local belts = {} -- key -> { dx, dz }
local ice = {} -- key -> true

local function readArena()
	arenaW = remotes:GetAttribute("ArenaW") or arenaW
	arenaH = remotes:GetAttribute("ArenaH") or arenaH
	originX = -(arenaW - 1) * T / 2
	originZ = -(arenaH - 1) * T / 2
	table.clear(belts)
	for entry in string.gmatch(remotes:GetAttribute("Belts") or "", "[^;]+") do
		local x, z, dx, dz = string.match(entry, "(-?%d+),(-?%d+),(-?%d+),(-?%d+)")
		if x then
			belts[tonumber(x) * 100 + tonumber(z)] = { dx = tonumber(dx), dz = tonumber(dz) }
		end
	end
	table.clear(ice)
	for entry in string.gmatch(remotes:GetAttribute("Ice") or "", "[^;]+") do
		local x, z = string.match(entry, "(-?%d+),(-?%d+)")
		if x then
			ice[tonumber(x) * 100 + tonumber(z)] = true
		end
	end
end
for _, name in ipairs({ "ArenaW", "ArenaH", "Belts", "Ice" }) do
	remotes:GetAttributeChangedSignal(name):Connect(readArena)
end
readArena()

local function cellOf(p)
	return math.floor((p.X - originX) / T + 0.5) + 1, math.floor((p.Z - originZ) / T + 0.5) + 1
end

-- Hear sounds from the middle of the arena, not from the high camera
SoundService:SetListener(Enum.ListenerType.CFrame, CFrame.new(0, 20, 0))

----------------------------------------------------------------------
-- Camera: from above. While alive it follows your player; when you are out
-- (or spectating) it shows the whole arena.
----------------------------------------------------------------------
local camFocus = Vector3.zero
local camDist = 100

local function distFor(cellsW, cellsH, margin)
	local vp = camera.ViewportSize
	local aspect = math.max(vp.X, 1) / math.max(vp.Y, 1)
	local t = math.tan(math.rad(camera.FieldOfView / 2))
	local halfH = (cellsH * T) / 2 + margin
	local halfW = (cellsW * T) / 2 + margin
	return math.max(halfH / t, halfW / (t * aspect)) * 1.05, halfW, halfH
end

RunService:BindToRenderStep("BombCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	camera.CameraType = Enum.CameraType.Scriptable
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local following = Config.CAMERA_FOLLOW and player:GetAttribute("Alive") and root and hum and hum.Health > 0

	local targetFocus, targetDist
	if following then
		local viewW = math.min(Config.CAMERA_VIEW_W, arenaW)
		local viewH = math.min(Config.CAMERA_VIEW_H, arenaH)
		local dist, halfW, halfH = distFor(viewW, viewH, 2)
		-- don't move past the edge of the arena
		local maxX = math.max(0, (arenaW * T) / 2 + T - halfW)
		local maxZ = math.max(0, (arenaH * T) / 2 + T - halfH)
		local p = root.Position
		targetFocus = Vector3.new(math.clamp(p.X, -maxX, maxX), 0, math.clamp(p.Z, -maxZ, maxZ))
		targetDist = dist
	else
		targetFocus = Vector3.zero
		targetDist = distFor(arenaW, arenaH, 6)
	end

	local a = 1 - math.exp(-Config.CAMERA_SMOOTH * dt)
	camFocus = camFocus:Lerp(targetFocus, a)
	camDist += (targetDist - camDist) * a
	-- slight tilt so "up" on screen stays north (-Z)
	camera.CFrame = CFrame.lookAt(camFocus + Vector3.new(0, camDist, camDist * 0.22), camFocus)
end)

----------------------------------------------------------------------
-- Conveyor belts: push your own character along
----------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
	if next(belts) == nil then
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return
	end
	local x, z = cellOf(root.Position)
	local b = belts[x * 100 + z]
	if b then
		root.CFrame += Vector3.new(b.dx, 0, b.dz) * Config.BELT_SPEED * dt
	end
end)

----------------------------------------------------------------------
-- Ice: you keep your momentum. We remember a "slide velocity" that only
-- slowly follows how you actually move, and push you by the difference.
----------------------------------------------------------------------
local slideVel = Vector3.zero
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

RunService.Heartbeat:Connect(function(dt)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		slideVel = Vector3.zero
		return
	end
	local x, z = cellOf(root.Position)
	if not ice[x * 100 + z] then
		slideVel = Vector3.zero
		return
	end
	local v = root.AssemblyLinearVelocity
	local hv = Vector3.new(v.X, 0, v.Z)
	slideVel += (hv - slideVel) * math.min(1, Config.ICE_GRIP * dt)
	local drift = (slideVel - hv) * dt
	if drift.Magnitude > 0.001 then
		rayParams.FilterDescendantsInstances = { char }
		local hit = workspace:Raycast(root.Position, drift.Unit * (drift.Magnitude + 1.2), rayParams)
		if hit and hit.Instance.CanCollide then
			slideVel = hv -- bumped into something: stop sliding
		else
			root.CFrame += drift
		end
	end
end)

----------------------------------------------------------------------
-- Corner assist: slide into the corridor when you are just next to an opening.
-- Fixed walls sit on cells with even x AND even z, so walking horizontally is only
-- possible in rows with an odd z, and vertically in columns with an odd x.
----------------------------------------------------------------------
local function laneOffset(p, origin)
	local idx = (p - origin) / T + 1 -- cell index (fractional)
	local lane = math.floor((idx - 1) / 2 + 0.5) * 2 + 1 -- nearest odd cell
	return origin + (lane - 1) * T - p
end

RunService.Heartbeat:Connect(function(dt)
	if not Config.CORNER_ASSIST then
		return
	end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return
	end
	local md = hum.MoveDirection
	if md.Magnitude < 0.5 then
		return
	end
	local maxStep = hum.WalkSpeed * dt
	local tol = T * Config.CORNER_TOLERANCE
	local pos = root.Position
	if math.abs(md.X) > math.abs(md.Z) * 1.5 then
		local off = laneOffset(pos.Z, originZ)
		if math.abs(off) > 0.05 and math.abs(off) < tol then
			root.CFrame += Vector3.new(0, 0, math.clamp(off, -maxStep, maxStep))
		end
	elseif math.abs(md.Z) > math.abs(md.X) * 1.5 then
		local off = laneOffset(pos.X, originX)
		if math.abs(off) > 0.05 and math.abs(off) < tol then
			root.CFrame += Vector3.new(math.clamp(off, -maxStep, maxStep), 0, 0)
		end
	end
end)

----------------------------------------------------------------------
-- Buttons
----------------------------------------------------------------------
ContextActionService:BindAction("PlaceBomb", function(_, state)
	if state == Enum.UserInputState.Begin then
		placeRemote:FireServer()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
ContextActionService:SetTitle("PlaceBomb", "💣")

ContextActionService:BindAction("ThrowBomb", function(_, state)
	if state == Enum.UserInputState.Begin then
		throwRemote:FireServer()
	end
	return Enum.ContextActionResult.Sink
end, true, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
ContextActionService:SetTitle("ThrowBomb", "🧤")

----------------------------------------------------------------------
-- HUD
----------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "BombHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

-- Scale everything with the screen size (phone = smaller)
local uiScale = Instance.new("UIScale")
uiScale.Parent = gui
local function rescale()
	local vp = camera.ViewportSize
	uiScale.Scale = math.clamp(math.min(vp.X / 900, vp.Y / 600), 0.5, 1)
end
camera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
rescale()

local function label(parent, props)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamBold
	l.TextSize = 18
	for k, v in pairs(props) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

-- Bottom bar with your goodies
local bar = Instance.new("Frame")
bar.AnchorPoint = Vector2.new(0.5, 1)
bar.Position = UDim2.new(0.5, 0, 1, -14)
bar.Size = UDim2.fromOffset(820, 52)
bar.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
bar.BackgroundTransparency = 0.25
bar.Parent = gui
Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 12)
local stroke = Instance.new("UIStroke")
stroke.Thickness = 3
stroke.Transparency = 1
stroke.Parent = bar
local layout = Instance.new("UIListLayout")
layout.FillDirection = Enum.FillDirection.Horizontal
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.VerticalAlignment = Enum.VerticalAlignment.Center
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = bar

local function statLabel(order)
	return label(bar, { LayoutOrder = order, Size = UDim2.fromOffset(96, 36) })
end
local lColor = statLabel(0)
local lBombs, lRange, lSpeed = statLabel(1), statLabel(2), statLabel(3)
local lPierce, lThrow, lKick, lPunch = statLabel(4), statLabel(5), statLabel(6), statLabel(7)
lColor.Size = UDim2.fromOffset(70, 36)

local curseLabel = label(gui, {
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -72),
	Size = UDim2.fromOffset(520, 28),
	TextColor3 = Color3.fromRGB(220, 160, 255),
	TextStrokeTransparency = 0.3,
	Visible = false,
})

local function toggle(l, on, emoji)
	l.Text = emoji .. " " .. tr(on and "on" or "off")
	l.TextTransparency = on and 0 or 0.55
end

local function refresh()
	lBombs.Text = "💣 " .. (player:GetAttribute("Bombs") or Config.START_BOMBS)
	lRange.Text = "🔥 " .. (player:GetAttribute("Range") or Config.START_RANGE)
	lSpeed.Text = "👟 " .. (player:GetAttribute("Speed") or Config.START_SPEED)
	toggle(lPierce, player:GetAttribute("Pierce"), "⚡")
	toggle(lThrow, player:GetAttribute("Throw"), "🧤")
	toggle(lKick, player:GetAttribute("Kick"), "🦶")
	toggle(lPunch, player:GetAttribute("Punch"), "🥊")
	local color = player:GetAttribute("Color")
	local colorKey = player:GetAttribute("ColorName")
	lColor.Text = colorKey and tr(colorKey) or ""
	lColor.TextColor3 = color or Color3.new(1, 1, 1)
	stroke.Color = color or Color3.new(1, 1, 1)
	stroke.Transparency = color and 0 or 1
	local curse = player:GetAttribute("Curse")
	curseLabel.Text = curse and tr(curse) or ""
	curseLabel.Visible = curse ~= nil
end
for _, name in ipairs({ "Bombs", "Range", "Speed", "Pierce", "Throw", "Kick", "Punch", "Color", "ColorName", "Curse" }) do
	player:GetAttributeChangedSignal(name):Connect(refresh)
end
refresh()

-- Help text: different on phone/tablet than with a keyboard
local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
label(gui, {
	AnchorPoint = Vector2.new(0, 0),
	Position = UDim2.new(0, 14, 0, 60),
	Size = UDim2.fromOffset(300, 44),
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	TextStrokeTransparency = 0.5,
	Font = Enum.Font.Gotham,
	TextSize = 14,
	Text = tr(touchOnly and "help_touch" or "help_keys"),
})

-- Timer top right
local timerLabel = label(gui, {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 56),
	Size = UDim2.fromOffset(260, 40),
	TextXAlignment = Enum.TextXAlignment.Right,
	TextStrokeTransparency = 0.3,
	Font = Enum.Font.GothamBlack,
	TextSize = 28,
	Text = "",
})

-- Spectator message
local spectateLabel = label(gui, {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 96),
	Size = UDim2.fromOffset(620, 30),
	TextStrokeTransparency = 0.3,
	TextSize = 20,
	Visible = false,
})

RunService.RenderStepped:Connect(function()
	local state = remotes:GetAttribute("State")
	if state == "playing" then
		if remotes:GetAttribute("SuddenDeath") then
			timerLabel.Text = tr("sudden_hud")
			timerLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
		else
			local left = math.max(0, (remotes:GetAttribute("RoundEndsAt") or 0) - workspace:GetServerTimeNow())
			timerLabel.Text = string.format("⏱️ %d:%02d", math.floor(left / 60), math.floor(left % 60))
			timerLabel.TextColor3 = left <= 15 and Color3.fromRGB(255, 200, 80) or Color3.new(1, 1, 1)
		end
	else
		timerLabel.Text = ""
	end

	if state == "playing" and not player:GetAttribute("Alive") then
		local n = remotes:GetAttribute("AliveCount") or 0
		if player:GetAttribute("InRound") then
			spectateLabel.Text = tr("spectate_out", { n = n })
		else
			spectateLabel.Text = tr("spectate_wait")
		end
		spectateLabel.Visible = true
		bar.Visible = false
	else
		spectateLabel.Visible = false
		bar.Visible = true
	end
end)

-- Big / small announcements
local banner = label(gui, {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 24),
	Size = UDim2.fromOffset(640, 56),
	Font = Enum.Font.GothamBlack,
	TextScaled = true,
	TextTransparency = 1,
	TextStrokeTransparency = 1,
})

local shown = 0
announceRemote.OnClientEvent:Connect(function(message, seconds, small)
	shown += 1
	local mine = shown
	banner.Text = tr(message)
	banner.Size = small and UDim2.fromOffset(520, 34) or UDim2.fromOffset(640, 56)
	banner.Position = small and UDim2.new(0.5, 0, 1, -112) or UDim2.new(0.5, 0, 0, 24)
	banner.AnchorPoint = small and Vector2.new(0.5, 1) or Vector2.new(0.5, 0)
	banner.TextTransparency = 0
	banner.TextStrokeTransparency = 0
	task.delay(seconds or 3, function()
		if mine == shown then
			TweenService:Create(banner, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
	end)
end)

----------------------------------------------------------------------
-- Scoreboard after every round
----------------------------------------------------------------------
local panel = Instance.new("Frame")
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.fromOffset(440, 120)
panel.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
panel.BackgroundTransparency = 0.1
panel.Visible = false
panel.Parent = gui
Instance.new("UICorner", panel).CornerRadius = UDim.new(0, 16)
local panelPad = Instance.new("UIPadding")
panelPad.PaddingTop = UDim.new(0, 14)
panelPad.PaddingBottom = UDim.new(0, 14)
panelPad.PaddingLeft = UDim.new(0, 18)
panelPad.PaddingRight = UDim.new(0, 18)
panelPad.Parent = panel
local panelList = Instance.new("UIListLayout")
panelList.Padding = UDim.new(0, 6)
panelList.SortOrder = Enum.SortOrder.LayoutOrder
panelList.Parent = panel

local resultShown = 0
resultRemote.OnClientEvent:Connect(function(title, rows, seconds, header)
	resultShown += 1
	local mine = resultShown
	for _, c in ipairs(panel:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	label(panel, {
		LayoutOrder = 0,
		Size = UDim2.new(1, 0, 0, 40),
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		Text = tr(title),
	})
	label(panel, {
		LayoutOrder = 1,
		Size = UDim2.new(1, 0, 0, 20),
		Font = Enum.Font.Gotham,
		TextSize = 15,
		TextTransparency = 0.3,
		Text = tr(header or "wins"),
	})
	for i, row in ipairs(rows) do
		local l = label(panel, {
			LayoutOrder = 1 + i,
			Size = UDim2.new(1, 0, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextSize = 20,
			Text = string.format("%s%d.  %s  –  %d", row.winner and "🏆 " or "", i, row.name, row.wins),
		})
		if row.color then
			l.TextColor3 = row.color
		end
	end
	panel.Size = UDim2.fromOffset(440, 28 + 46 + 26 + #rows * 32)
	panel.Visible = true
	task.delay(math.max(2, (seconds or 6) - 0.5), function()
		if mine == resultShown then
			panel.Visible = false
		end
	end)
end)

remotes:GetAttributeChangedSignal("State"):Connect(function()
	if remotes:GetAttribute("State") == "lobby" then
		panel.Visible = false
	end
end)
]]></ProtectedString>
</Properties></Item></Item></Item>
</roblox>